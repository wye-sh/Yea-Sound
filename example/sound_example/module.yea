# Sound's example view (component sound): every behaviour of the component on pads, with generated test sounds.
module sound_example
import sound u64 api(u32 version) = 0
# The pads' state: kept across code reloads (its voices play on), dropped by Reset.
table Demo none 1
  u32 engine
  u32 charge
  u32 hum
  u32 beacon_a
  u32 beacon_b
  u32 beacon_c
  u32 walking
  u32 music
  float walk
  float step_in
  float2 listener
  float orbit
end
default talk_robot_pitch -4
default talk_robot_highpass 0.45
default talk_robot_echo 0.35
default talk_giant_pitch -7
default talk_giant_speed 0.8
default talk_giant_bass 6
default talk_giant_reverb 0.6
